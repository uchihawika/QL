{
  "name": "战斗辅助",
  "entries": [
    {
      "name": "HP减少",
      "findRegex": "-hp(\\d+)",
      "replaceString": "{{decvar::hp::$1}}",
      "placements": ["user"],
      "timing": "send",
      "enabled": true,
      "trimStrings": [],
      "substitution": "raw",
      "minDepth": null,
      "maxDepth": null
    },
    {
      "name": "HP增加",
      "findRegex": "\\+hp(\\d+)",
      "replaceString": "{{addvar::hp::$1}}",
      "placements": ["user"],
      "timing": "send",
      "enabled": true,
      "trimStrings": [],
      "substitution": "raw",
      "minDepth": null,
      "maxDepth": null
    },
    {
      "name": "层数增加",
      "findRegex": "下一层|下一楼|继续",
      "replaceString": "{{incvar::floor}}",
      "placements": ["user"],
      "timing": "send",
      "enabled": true,
      "trimStrings": [],
      "substitution": "raw",
      "minDepth": null,
      "maxDepth": null
    },
    {
      "name": "敌人减少",
      "findRegex": "击败|击杀|消灭",
      "replaceString": "{{decvar::enemies_left}}",
      "placements": ["user"],
      "timing": "send",
      "enabled": true,
      "trimStrings": [],
      "substitution": "raw",
      "minDepth": null,
      "maxDepth": null
    },
    {
      "name": "状态栏格式化",
      "findRegex": "\\[状态\\](.*?)\\[/状态\\]",
